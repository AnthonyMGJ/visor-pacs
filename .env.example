# Copia este archivo como ".env" y CAMBIA todos los valores.
# Reglas: sin comillas, sin espacios alrededor del "=" y sin el símbolo "$".
# El archivo ".env" NUNCA se sube al repositorio (está en .gitignore).

DB_NAME=visor_pacs
DB_USER=pacs_user
DB_PASSWORD=cambiar_password_db
DB_ROOT_PASSWORD=cambiar_password_root

ORTHANC_USER=backend
ORTHANC_PASSWORD=cambiar_password_orthanc

# Al menos 32 caracteres. Para generarlo:  openssl rand -base64 48
JWT_SECRET=cambiar_por_un_texto_aleatorio_de_al_menos_32_caracteres

# Crea un médico de prueba al arrancar (solo desarrollo). La clave debe tener 12+ caracteres.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_USERNAME=medico.demo
BOOTSTRAP_PASSWORD=cambiar_esta_clave_de_prueba
# Paciente de prueba (opcional). DICOM_ID = PatientID de los estudios en Orthanc (muestras: PRUEBA-0001..3)
BOOTSTRAP_PACIENTE_USERNAME=paciente.demo
BOOTSTRAP_PACIENTE_PASSWORD=cambiar_clave_paciente_prueba
BOOTSTRAP_PACIENTE_DICOM_ID=PRUEBA-0001
# Administrador de prueba (opcional; gestiona cuentas y consulta la auditoría, no ve imágenes). Clave de 12+ caracteres.
BOOTSTRAP_ADMIN_USERNAME=admin.demo
BOOTSTRAP_ADMIN_PASSWORD=cambiar_clave_admin_prueba

# Origen del frontend React (Vite) en desarrollo (varios separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Documentación OpenAPI (/swagger-ui.html). En producción: false.
OPENAPI_ENABLED=true

# Opcional (permisos mínimos de la base, ver docs/despliegue/DESPLIEGUE.md): clave de la cuenta 'visor_app'.
# APP_DB_PASSWORD=cambiar_clave_visor_app
# Tope absoluto de una sesión en horas, y límite de inicios de sesión por IP (solicitudes por ventana).
# SESION_DURACION_MAXIMA_HORAS=8
# LIMITE_LOGIN_MAX=30
# LIMITE_LOGIN_VENTANA_SEGUNDOS=60
