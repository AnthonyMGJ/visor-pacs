                 {
                     "name":  "08 Login paciente -\u003e 200, rol PACIENTE y guarda token",
                     "request":  {
                                     "method":  "POST",
                                     "header":  [
                                                    {
                                                        "key":  "Content-Type",
                                                        "value":  "application/json"
                                                    }
                                                ],
                                     "url":  "{{baseUrl}}/api/auth/login",
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\"username\":\"{{pacienteUsername}}\",\"password\":\"{{pacientePassword}}\"}"
                                              }
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "pm.test(\"200 y rol PACIENTE\",()=\u003e{pm.response.to.have.status(200);const j=pm.response.json();pm.expect(j.rol).to.eql(\"PACIENTE\");pm.collectionVariables.set(\"tokenPaciente\",j.accessToken);});"
                                                               ]
                                                  }
                                   }
                               ]
                 },
