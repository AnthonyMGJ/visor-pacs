          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"token\":\"token-inventado-0123456789\",\"claveNueva\":\"{{claveNueva}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('mensaje generico', () => pm.expect(pm.response.json().detail).to.eql('El enlace no es válido o ya venció. Solicita uno nuevo.'));"
            ]
          }
        }
      ]
    },
