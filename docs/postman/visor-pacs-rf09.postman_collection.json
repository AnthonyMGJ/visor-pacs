    {
      "name": "16 CP-26 Mailpit: solo 3 correos de enlace (el 4.o no se envio)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{mailpitUrl}}/api/v1/search?query=to:{{qaEmail}}%20subject:Restablecer",
          "host": [
