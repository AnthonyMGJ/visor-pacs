        }
      ]
    },
    {
      "name": "12 CP-27 token inventado -> 400 sin pistas",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/restablecer-clave",
          "host": [
            "{{baseUrl}}"
          ],
